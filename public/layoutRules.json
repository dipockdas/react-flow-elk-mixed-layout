{
  "nodeStyles": {
    "vpc": { "backgroundColor": "rgba(26, 120, 186, 0.1)", "borderColor": "#1a78ba" },
    "subnet": { "backgroundColor": "rgba(26, 186, 137, 0.1)", "borderColor": "#1aba89" },
    "ec2": { "backgroundColor": "rgba(255, 153, 0, 0.2)", "width": 100, "height": 50 },
    "rds": { "backgroundColor": "rgba(153, 51, 204, 0.2)", "width": 100, "height": 50 },
    "s3": { "backgroundColor": "rgba(8, 125, 43, 0.2)", "borderColor": "#087d2b", "width": 100, "height": 50 }
  },
  "layoutRules": [
    {
      "comment": "When an EC2 instance connects to an RDS database, group them vertically.",
      "trigger": {
        "edge": {
          "sourceType": "ec2",
          "targetType": "rds"
        }
      },
      "action": "CREATE_VERTICAL_GROUP"
    },
    {
      "comment": "When an EC2 instance connects to an S3 bucket, group them vertically.",
      "trigger": {
        "edge": {
          "sourceType": "ec2",
          "targetType": "s3"
        }
      },
      "action": "CREATE_VERTICAL_GROUP"
    }
  ]
}